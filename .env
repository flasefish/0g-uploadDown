# ==================== 0g 网络配置（必填）====================
OG_CHAIN_URL=https://evmrpc-testnet.0g.ai
OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai  # 对应 EVM 测试网的索引器
OG_PRIVATE_KEY="0x"

# ==================== 文件路径配置（按需改）====================
# 要上传的 4GB 源文件路径（相对/绝对路径均可）
INPUT_FILE=./upload_4GB.bin
# 下载合并后的文件保存路径
OUTPUT_FILE=./downloaded_4gb.bin

# ==================== 运行参数配置（可选改）====================
# 整体操作超时时间（支持 1h=1小时、30m=30分钟、2h30m=2小时30分钟）
OP_TIMEOUT=1h
# 并发上传/下载协程数（建议 2-8，网络好可以调大）
CONCURRENT_ROUTINES=4
# 下载时是否验证 Merkle 证明（true=验证数据完整性，false=不验证）
DOWNLOAD_WITH_PROOF=true

# ==================== 分片配置（固定无需改）====================
# 分片大小：400MB（10个分片合计4GB）
FRAGMENT_SIZE=419430400
# 总文件大小：4GB（确保源文件符合）
TOTAL_FILE_SIZE=4294967296